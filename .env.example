DEBUG=True
LOCAL=True
SECRET_KEY=change-me-to-a-real-secret-key
DATABASE_URL=postgres://barbersync:password@localhost:5432/barbersync
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (AWS SES is configured via django-ses)

# App
DEFAULT_FROM_EMAIL=noreply@barbersync.app
SITE_URL=http://127.0.0.1:8000

# Google Maps (onboarding)
GOOGLE_MAPS_API_KEY=

# AWS SES Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=us-east-1
AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com

# ──────────────────────────────────────────────
# Billing – Stripe
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_DEFAULT_PROVIDER=stripe
BILLING_DEFAULT_CURRENCY=USD
BILLING_BASE_URL=

# Billing – Wompi (Colombia / COP)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENT_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_SANDBOX=True

# Reconciliación de webhooks perdidos (pulling directo a la API)
BILLING_RECONCILE_MIN_AGE_SECONDS=300

# Caché distribuida del middleware de suscripción (solo en prod)
# Si LOCAL=True el sistema usa LocMemCache automáticamente.
REDIS_URL=redis://127.0.0.1:6379/1